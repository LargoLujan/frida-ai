{
  "Jarvis": {
    // Modo de autenticación con Microsoft:
    //  "azcli" -> reutiliza tu sesión de 'az login' (NO necesita TenantId ni ClientId).
    //  "app"   -> registro de aplicación propio en Entra ID (requiere TenantId + ClientId).
    "AuthMode": "azcli",
    // Solo se usan en modo "app". Déjalos vacíos en modo "azcli".
    "TenantId": "",
    "ClientId": "",

    "Provider": "claude",
    // Modelo de IA. La API key se configura desde la ventana de Configuración (cifrada)
    // o vía variable de entorno ANTHROPIC_API_KEY.
    "Model": "claude-opus-4-8",
    // low | medium | high | max  (más alto = mejores respuestas, más lento/caro)
    "Effort": "high",

    // Ahorro de tokens: un modelo barato decide primero si el mensaje merece respuesta.
    // Solo si dice que sí se gasta el modelo potente + tools. Recomendado dejarlo activo.
    "TriageEnabled": true,
    // Modelo barato para el triaje (vacío = uno por defecto según proveedor).
    "TriageModel": "",

    "PollSeconds": 20,
    "DebounceSeconds": 10,
    "MaxContextMessages": 30,
    "MaxImages": 5,
    "MaxToolIterations": 15,

    // Quién eres: se inyecta en el system prompt como contexto y guardarraíl.
    // Vacío por defecto: rellénalo desde la ventana de Configuración.
    "Profile": {
      "Name": "",
      "Role": "",
      "Language": "es",
      "ExtraInstructions": ""
    },

    // Carpeta con .md de conocimiento personal (proyectos, convenciones, glosario...).
    // Se carga en el system prompt (cacheado). Vacío = %LOCALAPPDATA%\TeamsJarvis\knowledge
    "KnowledgeDir": "",

    "Cli": {
      "Az": { "Enabled": true, "AllowedVerbs": [ "list", "show" ] },
      "Fab": { "Enabled": true, "AllowedVerbs": [ "ls", "get", "exists", "desc", "api" ] }
    },

    // Servidores MCP cuyos tools quedan disponibles para el agente.
    // Tipo "stdio": { "Name": "azure", "Type": "stdio", "Command": "npx", "Arguments": [ "-y", "@azure/mcp@latest", "server", "start" ] }
    // Tipo "http":  { "Name": "misjardines", "Type": "http", "Url": "https://ejemplo.com/mcp" }
    "McpServers": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  }
}
