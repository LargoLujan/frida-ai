<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>TeamsJarvis</AssemblyName>
    <RootNamespace>TeamsJarvis</RootNamespace>
    <ApplicationIcon>frida.ico</ApplicationIcon>
    <!-- Marca: Frida.ai. El AssemblyName interno se mantiene (TeamsJarvis) para no cambiar la
         ruta de datos %LOCALAPPDATA%\TeamsJarvis ni invalidar la clave/memoria ya cifradas. -->
    <Company>Frida.ai</Company>
    <Product>Frida.ai</Product>
    <Description>Frida.ai — asistente personal de respuestas para Microsoft Teams</Description>
    <Version>1.0.0</Version>
    <!-- Rendimiento en escritorio: GC de estación de trabajo (menos RAM/CPU que el de servidor),
         GC concurrente para no bloquear la UI, y compilación por niveles para arranque rápido. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.35.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Graph" Version="6.2.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0-preview.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <!-- Evita que WinForms contamine los global usings (ambigüedades Application/MessageBox/
       Clipboard/Message) y restaura System.IO. WinForms solo se usa explícitamente en el tray. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\teamsReader.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeamsJarvis.Tests" />
  </ItemGroup>

</Project>
