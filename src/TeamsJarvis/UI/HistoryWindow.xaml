<Window x:Class="TeamsJarvis.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sugerencias anteriores" Height="540" Width="720"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" x:Name="HistoryList" SelectionChanged="OnSelected"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#777"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="DetailHeader" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Grid.Row="1" x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="8"/>
            <Button Grid.Row="2" Content="📋 Copiar" HorizontalAlignment="Right" Margin="0,8,0,0"
                    Padding="14,6" Background="#6264A7" Foreground="White" BorderThickness="0"
                    Click="OnCopy"/>
        </Grid>
    </Grid>
</Window>
