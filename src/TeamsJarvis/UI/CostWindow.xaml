<Window x:Class="TeamsJarvis.UI.CostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Costes de la API de IA" Height="600" Width="640"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" Background="#F3F3F7">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#6264A7"/>
        <SolidColorBrush x:Key="Muted" Color="#6A6A75"/>
        <Style TargetType="Border" x:Key="Stat">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#E3E3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Aviso Max -->
        <Border Grid.Row="0" Background="#FFF4E5" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontWeight="Bold" Foreground="#8A5A00" FontSize="14" Text="⚠ Esto es coste de API, aparte de tu suscripción"/>
                <TextBlock Foreground="#8A5A00" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Una suscripción como Claude Max NO incluye el uso de la API. Cada sugerencia que genera Jarvis consume tokens de la API, que se facturan por separado según tu plan de plataforma/consola. Estas cifras son una estimación basada en los precios públicos por millón de tokens."/>
            </StackPanel>
        </Border>

        <!-- Tarjetas resumen -->
        <UniformGrid Grid.Row="1" Columns="3">
            <Border Style="{StaticResource Stat}">
                <StackPanel>
                    <TextBlock Text="Hoy" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="TodayCost" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="TodayCalls" Text="" Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel>
                    <TextBlock Text="Este mes" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="MonthCost" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="MonthCalls" Text="" Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel>
                    <TextBlock Text="Proyección mensual" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="Projection" Text="—" FontSize="22" FontWeight="Bold" Foreground="#C0392B"/>
                    <TextBlock Text="al ritmo de este mes" Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" x:Name="TotalsText" Foreground="{StaticResource Muted}" FontSize="12" Margin="4,10,0,6"/>

        <!-- Desglose por modelo -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E3E3EC" BorderThickness="1" Padding="4">
            <DataGrid x:Name="ModelGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="White" RowBackground="White" AlternatingRowBackground="#F7F7FB">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*"/>
                    <DataGridTextColumn Header="Llamadas" Binding="{Binding Calls}" Width="100"/>
                    <DataGridTextColumn Header="Coste (mes)" Binding="{Binding CostText}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="RateNote" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MaxWidth="380"/>
            <Button Content="Cerrar" HorizontalAlignment="Right" Padding="16,7"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                    Click="OnClose"/>
        </DockPanel>
    </Grid>
</Window>
