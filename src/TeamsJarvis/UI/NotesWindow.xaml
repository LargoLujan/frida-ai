<Window x:Class="TeamsJarvis.UI.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notas y recordatorios" Height="640" Width="900"
        MinHeight="460" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F3F3F7">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#6264A7"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="10" Background="Transparent">
        <!-- NOTAS -->
        <TabItem Header="📝 Notas">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <Button DockPanel.Dock="Bottom" Content="➕ Nueva nota" Margin="0,8,0,0" Click="OnNewNote"/>
                    <ListBox x:Name="NotesList" SelectionChanged="OnNoteSelected" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="#888">
                                        <Run Text="{Binding Project, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UpdatedText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NoteTitle" Grid.Column="0" Padding="6,5" FontSize="14" Margin="0,0,8,0"
                                 Tag="Título de la nota"/>
                        <TextBox x:Name="NoteProject" Grid.Column="1" Padding="6,5" Tag="Proyecto (opcional)"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="💾 Guardar" Background="{StaticResource Accent}" Foreground="White"
                                BorderThickness="0" Click="OnSaveNote"/>
                        <Button Content="🗑 Borrar" Click="OnDeleteNote"/>
                    </StackPanel>
                    <Border Background="White" CornerRadius="6" BorderBrush="#E3E3EC" BorderThickness="1">
                        <TextBox x:Name="NoteBody" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8" FontSize="13"/>
                    </Border>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- RECORDATORIOS -->
        <TabItem Header="⏰ Recordatorios">
            <DockPanel Margin="6">
                <!-- Alta de recordatorio -->
                <Border DockPanel.Dock="Top" Background="White" CornerRadius="6" BorderBrush="#E3E3EC"
                        BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RemText" Grid.Column="0" Padding="6,5" VerticalAlignment="Center"
                                 Margin="0,0,8,0" Tag="¿De qué te aviso?"/>
                        <DatePicker x:Name="RemDate" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="RemTime" Grid.Column="2" Width="80" IsEditable="True" VerticalAlignment="Center"
                                  Margin="0,0,6,0" ToolTip="Hora HH:mm"/>
                        <TextBox x:Name="RemProject" Grid.Column="3" Width="120" Padding="6,5" VerticalAlignment="Center"
                                 Margin="0,0,6,0" Tag="Proyecto"/>
                        <Button Grid.Column="4" Content="➕ Añadir" Background="{StaticResource Accent}" Foreground="White"
                                BorderThickness="0" Click="OnAddReminder"/>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top" x:Name="RemHeader" Text="Recordatorios" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <Border Background="White" CornerRadius="6" BorderBrush="#E3E3EC" BorderThickness="1">
                    <ListBox x:Name="RemList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Done}" VerticalAlignment="Center"
                                              Margin="0,0,8,0" Click="OnToggleDone" Tag="{Binding Id}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                   TextDecorations="{Binding Strike}" Foreground="{Binding Fg}"/>
                                        <TextBlock FontSize="11" Foreground="{Binding DueFg}">
                                            <Run Text="{Binding DueText, Mode=OneWay}"/><Run Text="{Binding ProjectSuffix, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="📅 .ics" Padding="8,3" Margin="0,0,4,0" Click="OnExportIcs" Tag="{Binding Id}"
                                                ToolTip="Exporta a tu calendario (Teams/Outlook) sin tocar el tenant"/>
                                        <Button Content="🗑" Padding="8,3" Click="OnDeleteReminder" Tag="{Binding Id}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
