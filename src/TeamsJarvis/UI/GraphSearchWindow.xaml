<Window x:Class="TeamsJarvis.UI.GraphSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Búsqueda en conversaciones" Height="640" Width="960"
        MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F3F3F7">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#6264A7"/>
        <SolidColorBrush x:Key="Muted" Color="#6A6A75"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="🔎 Buscar" Padding="16,7" Margin="8,0,0,0"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                    Click="OnSearch"/>
            <CheckBox x:Name="SemanticBox" DockPanel.Dock="Right" Content="🧠 Semántica" VerticalAlignment="Center"
                      Margin="10,0,0,0" Checked="OnModeChanged" Unchecked="OnModeChanged"
                      ToolTip="Busca por significado (embeddings locales), no solo por palabras exactas."/>
            <TextBox x:Name="SearchBox" Padding="8,6" FontSize="14" KeyDown="OnSearchKeyDown"
                     ToolTip="Palabras clave (todas deben aparecer). Vacío = últimos mensajes del filtro."/>
        </DockPanel>

        <!-- Personas -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="Personas" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <Border DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="Quitar filtro de persona" Padding="6,4" Click="OnClearPerson"/>
            </Border>
            <ListBox x:Name="PeopleList" SelectionChanged="OnPersonSelected" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="#777">
                                <Run Text="{Binding MessageCount, Mode=OneWay}"/><Run Text=" msgs · "/><Run Text="{Binding ChatCount, Mode=OneWay}"/><Run Text=" chats"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Resultados -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <TextBlock x:Name="ResultsHeader" DockPanel.Dock="Top" Text="Resultados" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <Border Background="White" CornerRadius="8" BorderBrush="#E3E3EC" BorderThickness="1">
                <ListBox x:Name="ResultsList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold" FontSize="12" Foreground="#6264A7"/>
                                    <TextBlock Text="{Binding ChatName}" FontSize="11" Foreground="#999" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#999" Margin="8,0,0,0"/>
                                    <Border Background="#E8E8F5" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                            Visibility="{Binding ScoreVisibility}">
                                        <TextBlock Text="{Binding ScoreText}" FontSize="10" Foreground="#6264A7"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Relaciones -->
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,0">
            <TextBlock DockPanel.Dock="Top" x:Name="RelHeader" Text="Relaciones" FontWeight="SemiBold" Margin="2,0,0,4"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Chats en común" FontSize="12" FontWeight="SemiBold" Margin="2,4,0,2"/>
                    <ItemsControl x:Name="ChatsOfPerson">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left" Margin="0,1" Padding="6,3"
                                        Background="#ECECF4" BorderThickness="0" Click="OnChatChip" Tag="{Binding ChatId}">
                                    <TextBlock Text="{Binding ChatName}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Coincide con" FontSize="12" FontWeight="SemiBold" Margin="2,10,0,2"/>
                    <ItemsControl x:Name="CoParticipants">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="2,1" FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
