<Window x:Class="TeamsJarvis.UI.ChatSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir chats a monitorizar" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Marca las conversaciones en las que Frida.ai debe leer los mensajes nuevos y sugerirte respuestas."/>

        <TextBox Grid.Row="1" x:Name="FilterBox" Margin="0,0,0,8" Padding="6"
                 TextChanged="OnFilterChanged" ToolTip="Filtrar por nombre"/>

        <ListBox Grid.Row="2" x:Name="ChatsList" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="2,4">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#777"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" Click="OnCancel"/>
                <Button Content="Guardar" Padding="14,6" Background="#6264A7" Foreground="White"
                        BorderThickness="0" Click="OnSave"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
